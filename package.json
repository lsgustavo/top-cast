{
  "name": "top-cast",
  "version": "0.1.0",
  "description": "TopCast desktop app",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:server\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host --strictPort --port 4173",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:electron": "tsc -p tsconfig.node.json && wait-on tcp:4173 tcp:3001 && electron dist-electron/main/main.js",
    "build": "tsc -p tsconfig.node.json && tsc -p tsconfig.server.json && tsc -p tsconfig.app.json && vite build",
    "build:windows": "npm run build && node scripts/verify-production-build.mjs",
    "verify:production": "node scripts/verify-production-build.mjs",
    "preview": "vite preview --host",
    "test": "tsx --test src/server/services/room-service.test.ts src/server/services/signaling-validation.test.ts"
  },
  "keywords": [
    "electron",
    "screen-sharing",
    "webrtc",
    "desktop"
  ],
  "author": "TopCast",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@radix-ui/react-slot": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "electron": "^44.6.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "wait-on": "^9.5.1"
  }
}
