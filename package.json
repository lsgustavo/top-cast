{
  "name": "top-cast",
  "version": "0.1.0",
  "description": "TopCast desktop app",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:server\" \"npm:dev:electron\"",
    "dev:renderer": "vite --config vite.config.ts --host --strictPort --port 4173",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:electron": "tsc -p tsconfig.node.json && wait-on tcp:4173 tcp:3001 && electron dist-electron/main/main.js",
    "build": "tsc -p tsconfig.node.json && tsc -p tsconfig.server.json && tsc -p tsconfig.app.json && vite build --config vite.config.ts",
    "build:native": "node-gyp rebuild",
    "build:windows": "npm run build && node scripts/verify-production-build.mjs",
    "build:installer": "node scripts/verify-installer-config.mjs && npm run build:windows && electron-builder --win nsis --x64",
    "verify:production": "node scripts/verify-production-build.mjs",
    "test:signaling-smoke": "node scripts/smoke-test-signaling.mjs",
    "preview": "vite preview --config vite.config.ts --host",
    "test": "tsx --test src/server/services/room-service.test.ts src/server/services/signaling-validation.test.ts src/server/services/ice-credentials.test.ts tests/ice-configuration.test.ts tests/reconnect-identity.test.ts tests/room-ui.test.ts tests/participant-events.test.ts tests/theme.test.ts tests/welcome-dialog.test.ts tests/tooltip.test.ts"
  },
  "keywords": [
    "electron",
    "screen-sharing",
    "webrtc",
    "desktop"
  ],
  "author": "TopCast",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tooltip": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.5",
    "lucide-react": "^1.52.0",
    "node-addon-api": "^8.9.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.topcast.desktop",
    "productName": "TopCast",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "dist-server/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TopCast-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TopCast"
    }
  }
}
